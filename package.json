{
  "name": "react-structured",
  "version": "0.1.1",
  "description": "Type-safe React components for Schema.org JSON-LD structured data, rich results, and @graph documents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanhefner/react-structured.git"
  },
  "author": "Ryan Hefner <hi@ryanhefner.com> (https://www.ryanhefner.com)",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ryanhefner/react-structured/issues"
  },
  "homepage": "https://react-structured.dev",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ryanhefner"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/ryanhefner"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/ryanhefner"
    }
  ],
  "keywords": [
    "react",
    "json-ld",
    "jsonld",
    "ld-json",
    "react-json-ld",
    "schema.org",
    "schema-org",
    "schema",
    "schema-dts",
    "structured-data",
    "rich-results",
    "google-rich-results",
    "google-search",
    "seo",
    "metadata",
    "next",
    "nextjs",
    "app-router",
    "typescript"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "types",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./types/index.d.ts",
  "scripts": {
    "clean": "rimraf dist types coverage",
    "build": "pnpm run clean && rollup -c --bundleConfigAsCjs && tsc -p tsconfig.json",
    "dev": "rollup -c --bundleConfigAsCjs --watch",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:tooling": "node --test scripts/tooling.test.mjs",
    "docs:dev": "pnpm run build && pnpm --dir docs dev",
    "docs:build": "pnpm run build && pnpm --dir docs build",
    "docs:typecheck": "pnpm --dir docs typecheck",
    "docs:verify": "node --test scripts/docs.test.mjs scripts/site-structured-data.test.mjs",
    "docs:release-check": "node scripts/check-docs-release.mjs",
    "verify": "pnpm run test:tooling && pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "peerDependencies": {
    "react": ">=16.14"
  },
  "dependencies": {
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^4.0.16",
    "axe-core": "4.12.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@11.25.0"
}
