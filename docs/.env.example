# Optional opengraphs.com renderer prefix for per-page PNG metadata.
# Capture pages live at /social-image, /docs/<slug>/social-image, and /withoss/social-image.
# NEXT_PUBLIC_OG_IMAGE_BASE_URL=https://your-project.opengraphs.com/react-structured.dev/

# Optional React Fathom analytics; leave blank to disable network tracking.
NEXT_PUBLIC_FATHOM_SITE_ID=
NEXT_PUBLIC_FATHOM_CUSTOM_DOMAIN=cdn.usefathom.com
